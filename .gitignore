# ==============================================================================
# Python & Окружение
# ==============================================================================
# Виртуальные окружения (локальные)
.venv/
venv/
env/
ENV/
/dist/
/build/

# Кэш Python компилятора
**/__pycache__/
*.py[cod]
*$py.class

# ==============================================================================
# Переменные окружения и Секреты (ВАЖНО!)
# ==============================================================================
# Конфиденциальные данные, JWT ключи, пароли от Postgres/RabbitMQ
.env
!.env.example   # Исключение: шаблон файла .env коммитить МОЖНО
secrets.json
*.pem
*.key

# ==============================================================================
# Django конкретно
# ==============================================================================
# Локальная база SQLite (если осталась от тестов)
*.sqlite3
*.db

# Медиа-файлы пользователей (загружаемые аватарки, файлы тикетов и т.д.)
/media/
/staticfiles/
static_collected/

# Логи Django и FastAPI
*.log
celerybeat-schedule

# ==============================================================================
# FastAPI / Тестирование / Документация
# ==============================================================================
# Логи и отчеты pytest
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# Docker & Брокеры (RabbitMQ / Redis)
# ==============================================================================
# Локальные папки данных для Docker-контейнеров (чтобы данные БД не лезли в Git)
.docker_data/
postgres_data/
rabbitmq_data/
redis_data/

# ==============================================================================
# Системные файлы и IDE
# ==============================================================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db
